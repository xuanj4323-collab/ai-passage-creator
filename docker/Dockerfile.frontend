# syntax=docker/dockerfile:1
# ============================================================
# 前端镜像（多阶段构建）
#
#   阶段1 用 node 构建出静态文件 dist/，
#   阶段2 只把 dist 拷进 nginx，同时带上反向代理配置。
#   最终镜像里没有 node_modules，也没有源码。
# ============================================================

# ---------- 阶段 1：构建 ----------
FROM node:22-alpine AS build
WORKDIR /build

# 先拷依赖清单，利用层缓存：不改依赖时 npm ci 这层不会重跑
COPY frontend/ai-passage-creator/package.json frontend/ai-passage-creator/package-lock.json ./
RUN npm ci --registry=https://registry.npmmirror.com

COPY frontend/ai-passage-creator/ ./
# build 脚本 = vue-tsc 类型检查 + vite build，
# 类型错误会让构建失败，这是好事：生产产物不该带着类型问题发出去
RUN npm run build

# ---------- 阶段 2：运行 ----------
FROM nginx:1.27-alpine

# 覆盖默认站点配置（含 SSE 所需的 proxy_buffering off）
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist /usr/share/nginx/html

EXPOSE 80
